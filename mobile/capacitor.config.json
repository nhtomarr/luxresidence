{
  "appId": "az.rahmangroup.basofis",
  "appName": "Baş Ofis",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "*.pilothayat.az",
      "ofis.pilothayat.az",
      "luxresidence.az",
      "*.luxresidence.az",
      "*.supabase.co",
      "cdn.jsdelivr.net",
      "cdnjs.cloudflare.com",
      "fonts.googleapis.com",
      "fonts.gstatic.com"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0f172a"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "resetWhenUpdate": true,
      "appReadyTimeout": 15000
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#081634"
    }
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0f172a",
    "limitsNavigationsToAppBoundDomains": false
  }
}