// VMM Ofis → Cloudflare Worker. Yükləmə: python3 vmm/build.py <versiya> && cd vmm && npx wrangler deploy
// Domenlər: ofis.vmm.az, vmm.az, www.vmm.az (Cloudflare → Workers → vmm-ofis → Domains)
{
  "name": "vmm-ofis",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "not_found_handling": "single-page-application", "run_worker_first": ["/auth-ok", "/auth-ok.txt"] },
  "workers_dev": true
}
